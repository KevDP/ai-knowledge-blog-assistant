# Copia este archivo a `.env` y rellena con tus valores reales.
# `.env` está en .gitignore — JAMÁS lo commitees.

# ──────────────────────────────────────────────────────────────────────────
# Fase 0 (RAG local) — Anthropic API directo
# ──────────────────────────────────────────────────────────────────────────
# Saca tu key en https://console.anthropic.com/settings/keys
# Al registrarte recibes ~$5 de crédito gratis — suficiente para Fase 0.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Haiku es el más barato y rápido. Sonnet si quieres mejor calidad.
# IDs vigentes: claude-haiku-4-5 (si disponible) | claude-3-5-haiku-20241022
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ──────────────────────────────────────────────────────────────────────────
# Fase 1 (deploy AWS) — se rellena cuando lleguemos ahí
# ──────────────────────────────────────────────────────────────────────────
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# DYNAMODB_TABLE=eva-embeddings
